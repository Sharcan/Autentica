---
import Image from "astro/components/Image.astro";
import landingItalia from "../assets/images/landing_italia.jpg";
---

<section class="hero flex align-center">
    <Image src={landingItalia} alt="Landing Italia" class="hero-img-background" />
    <div class="hero-img-wrapper"></div>

    <div class="hero-content flex column">
        <p class="top-title">Expériences de voyages sur mesure en Italie</p>

        <h1 class="title">L’Italie comme vous ne l’avez jamais imaginée</h1>

        <p class="title-description">
            Des voyages sur mesure façonnés autour de vos envies, de mes adresses préférées et d’inspirations locales
            pour découvrir une Italie authentique, loin des itinéraires classiques.
        </p>

        <div class="top-action flex row">

            <button class="learn-more">
                En savoir plus
            </button>


            <button class="contact-me">
                Contactez-moi
            </button>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        margin-top: calc(var(--header-h) * -1);
        background-color: var(--c-terracotta-deep);
        height: 100dvh;
        isolation: isolate;

        padding-block: var(--space-2xl);
    }

    .hero-img-background,
    .hero-img-wrapper {
        position: absolute;
        inset: 0;
        z-index: -1;
    }

    .hero-img-background {
        object-fit: cover;
        width: 100%;
        height: 100%;
    }

    .hero-img-wrapper {
        background:
            linear-gradient(
                    104deg,
                    rgb(64 33 20 / 0.86) 10%,
                    rgb(166 78 46 / 0.62) 75%,
                    rgb(166 78 46 / 0.12) 100%,
                    transparent 100%
            ),
            linear-gradient(to top, rgb(64 33 20 / 0.5), transparent 45%);
    }

    .hero-content {
        padding-inline: var(--space-xl);
        color: var(--c-cream);
        font-size: var(--step-0);
        width: 100%;
        max-width: 1160px;

        gap: var(--space-s);

        margin-inline: auto;
    }

    .top-title {
        text-transform: uppercase;
        font-style: var(--step--1);
    }

    .title {
        max-width: 20ch;
    }

    .title-description {
        max-width: 54ch;
        font-size: var(--step-1);
    }

    .top-action {
        max-width: 75%;
        gap: var(--space-s);
        flex-wrap: wrap;
    }

    .top-action > button {
        border-radius: var(--radius-pill);
        transition: 300ms ease-in-out;

        font-size: var(--step--1);
        text-transform: uppercase;
        font-weight: 400;

        padding-inline: var(--space-m);
        padding-block: var(--space-xs);

        flex: 1;
    }

    .top-action > button:hover {
        transform: translateY(-2px);
    }

    .learn-more {
        background-color: var(--c-cream);
        color: var(--c-ink);
    }

    .learn-more:hover {
        background-color: var(--c-limestone);
    }

    .contact-me {
        border: 1px solid var(--c-cream);
        color: var(--c-cream);
    }

    .contact-me:hover {
        color: var(--c-ink);
        background-color: var(--c-cream);
    }

    @media (max-width: 850px) {
        .top-title {
            display: none;
        }

        .hero-content {
            padding-inline: var(--space-m);
        }

        .top-action {
            flex: 100%;
        }
    }
</style>