---
import OliveBranch from './OliveBranch.astro';
import links from '../assets/data/nav-links.json'
import legalsLinks from '../assets/data/legals-links.json'
import siteInformations from '../assets/data/site-informations.json'

const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="container footer__inner">
        <div class="footer__brand">
            <span class="footer__branch"><OliveBranch /></span>
            <p class="footer__wordmark">{siteInformations.siteMeta.name}</p>
            <p class="footer__baseline">{siteInformations.siteMeta.baseline}</p>
        </div>

        <nav class="footer__col" aria-label="Navigation du pied de page">
            <h2 class="footer__title">Le voyage</h2>
            <ul class="footer__list">
                {
                    links.map((link) => (
                            <li>
                                <a class="footer__link" href={link.href}>
                                    {link.label}
                                </a>
                            </li>
                    ))
                }
                <li><a class="footer__link" href="#contact">Contact</a></li>
            </ul>
        </nav>

        <div class="footer__col">
            <h2 class="footer__title">Me joindre</h2>
            <ul class="footer__list">
                <li><a class="footer__link" href={`mailto:${siteInformations.contact.email}`}>{siteInformations.contact.email}</a></li>
                <li>
                    <a class="footer__link" href={siteInformations.contact.instagramUrl} rel="noopener">
                        Instagram {siteInformations.contact.instagram}
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <div class="container footer__bottom">
        <p>© {year} {siteInformations.siteMeta.name}. Tous droits réservés.</p>
        <ul class="footer__legal">
            {
                legalsLinks.map((link) => (
                        <li>
                            <a class="footer__link" href={link.href}>
                                {link.label}
                            </a>
                        </li>
                ))
            }
        </ul>
    </div>
</footer>

<style>
    .footer {
        background-color: var(--c-terracotta-deep);
        color: var(--c-limestone);
        padding-block: var(--space-xl) var(--space-m);
        padding-inline: var(--space-2xl);
    }

    .footer__inner {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: var(--space-l);
        padding-bottom: var(--space-l);
    }

    .footer__branch {
        display: block;
        width: 92px;
        color: var(--c-sand);
        margin-bottom: var(--space-s);
    }

    .footer__wordmark {
        font-family: var(--font-display);
        font-size: var(--step-3);
        font-weight: 400;
        letter-spacing: 0.24em;
        line-height: 1;
        color: var(--c-cream);
    }

    .footer__baseline {
        margin-top: var(--space-xs);
        font-size: var(--step--1);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--c-cream);
    }

    .footer__title {
        font-family: var(--font-body);
        font-size: var(--step--1);
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--c-cream);
        margin-bottom: var(--space-s);
    }

    .footer__list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.55em;
    }

    .footer__link {
        color: var(--c-cream);
        font-size: var(--step--1);
        text-decoration: none;
    }

    .footer__link:hover {
        text-decoration: underline;
    }

    .footer__bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-xs);
        padding-top: var(--space-m);
        border-top: 1px solid rgb(252 240 228 / 0.22);
        font-size: var(--step--1);
        color: var(--c-cream);
    }

    .footer__legal {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s);
        list-style: none;
    }

    @media (max-width: 800px) {
        .footer__inner {
            grid-template-columns: 1fr;
            gap: var(--space-m);
        }
    }
</style>
