---
import OliveBranch from "./OliveBranch.astro";
import siteInformations from "../assets/data/site-informations.json"
---


<section class="citation flex column justify-center align-center">
    <div class="olive-wrapper">
        <OliveBranch />
    </div>

    <p class="font-display">
        {siteInformations.citation.message}
    </p>

    <span class="author font-display">
        {siteInformations.citation.author}
    </span>
</section>


<style>
    .citation {
        height: 45dvh;

        background-color: var(--c-olive);
        padding-block: var(--space-l);
        padding-inline: var(--space-2xl);

        color: var(--c-cream);

        gap: var(--space-m);
    }

    .citation > p {
        font-size: var(--step-3);
        text-align: center;
    }

    .citation > p::before {
        content: "«";
    }

    .citation > p::after {
        content: "»";
    }

    .olive-wrapper {
        width: 100px;
        color: var(--c-sand);
    }

    .author {
        font-size: var(--step-1);
        font-style: italic;
    }

    @media (max-width: 860px) {
        .citation > p {
            font-size: var(--step-2);
        }
    }
</style>