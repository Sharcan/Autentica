---

const links = [
    {
        href: '#about-me',
        label: 'Qui suis-je'
    },
    {
        href: '#method',
        label: 'Méthode'
    },
    {
        href: '#formula',
        label: 'Formule'
    },
    {
        href: '#how',
        label: 'Concièrgerie'
    },
    {
        href: '#inspiration',
        label: 'Inspirations'
    },
];

---

<header data-header class="header flex row justify-between align-center">
    <a href="/Autentica" class="wordmark flex column">
        <span class="header__title">
            Autentica
        </span>

        <span class="header__subtitle">
            Voyages sur mesure en Italie
        </span>
    </a>

    <button id="burger-btn" type="button" class="burger__btn">
        <span class="burger__bars"></span>
    </button>

    <nav data-navigation class="flex row align-center">
        <ul>
            {
                links.map(
                    (link) =>
                        <li>
                            <a href={link.href} class="nav__link">
                                {link.label}
                            </a>
                        </li>
                )
            }
        </ul>

        <button class="contact-me-btn">
            Contactez-moi
        </button>
    </nav>
</header>

<style>
    header.header {
        text-transform: uppercase;
        padding-block: var(--space-xs);
        padding-inline: var(--space-m);
        color: var(--c-cream);

        position: sticky;
        inset: 0;
        height: var(--header-h);

        transition: 300ms var(--ease);
    }

    header.header.is-scrolled {
        background-color: var(--c-cream);
        color: var(--c-ink);
    }

    .wordmark {
        line-height: normal;
    }

    .header__title {
        font-family: var(--font-display);
        font-size: var(--step-2);
        font-weight: 500;
        letter-spacing: 0.2rem;
    }

    .header__subtitle {
        font-family: var(--font-display);
        font-size: var(--step-0);
        font-weight: 300;
        letter-spacing: 0.2rem;
    }

    .burger__btn {
        display: none;
    }

    .header.is-scrolled .burger__bars,
    .header.is-scrolled .burger__bars::before,
    .header.is-scrolled .burger__bars::after {
        background-color: var(--c-ink);
    }

    .burger__bars,
    .burger__bars::before,
    .burger__bars::after {
        display: block;
        width: 1.5rem;
        height: 1px;
        background-color: var(--c-cream);
        transition: transform 0.3s var(--ease),
            opacity 0.2s var(--ease);
    }

    .burger__bars {
        position: relative;
    }

    .burger__bars::before,
    .burger__bars::after {
        content: '';
        position: absolute;
        inset-inline-start: 0;
    }

    .burger__bars::before {
        transform: translateY(calc(-1 * var(--space-2xs)));
    }

    .burger__bars::after {
        transform: translateY(var(--space-2xs));
    }

    .burger__btn.is-open > .burger__bars {
        transform: rotate(45deg);
    }

    .burger__btn.is-open > .burger__bars::before {
        opacity: 0;
    }

    .burger__btn.is-open > .burger__bars::after {
        transform: rotate(-90deg);
    }

    nav[data-navigation] ul li {
        margin-right: var(--space-s);
    }

    .nav__link {
        position: relative;
    }

    .nav__link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -5px;
        width: 0;
        height: 1px;
        background-color: var(--c-cream);

        transition: 300ms ease-in-out;
    }

    .nav__link:hover::after {
        width: 100%;
    }

    [data-header].is-scrolled .nav__link::after {
        background-color: var(--c-ink);
    }

    .contact-me-btn {
        border: 1px solid var(--c-terracotta);
        background-color: var(--c-terracotta);
        border-radius: var(--radius-pill);
        color: var(--c-cream);

        padding-block: var(--space-2xs);
        padding-inline: var(--space-s);

        transition: 300ms ease-in-out;
    }

    .contact-me-btn:hover {
        background-color: var(--c-cream);
        color: var(--c-ink);
    }

    @media (max-width: 1120px) {
        .burger__btn {
            display: block;
        }

        nav[data-navigation] {
            position: absolute;

            top: var(--header-h);
            left: 0;

            width: 100dvw;
            height: auto;

            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;

            background-color: var(--c-cream);
            padding-inline: var(--space-m);
            color: var(--c-ink);

            visibility: hidden;
            opacity: 0;
            transform: translateY(-2%);
            transition: all 300ms var(--ease);
        }

        nav[data-navigation].is-open {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }

        nav[data-navigation] ul {
            width: 100%;
        }

        nav[data-navigation] ul li {
            position: relative;
            display: block;

            margin-top: var(--space-m);
            font-size: var(--step-1);
        }

        nav[data-navigation] ul li::before {
            background-color: var(--c-limestone);
            content: '';
            width: 100%;
            height: 1px;
            position: absolute;
            bottom: -5px;
            left: 0;
        }

        .nav__link::after {
            display: none;
        }

        .contact-me-btn {
            font-size: var(--step-1);
            margin-block: var(--space-m);
        }
    }
</style>

<script>
    const headerHtml: HTMLElement | null = document.querySelector('[data-header]');
    const navigationHtml : HTMLElement | null = document.querySelector('[data-navigation]');
    const burgerButton: HTMLElement | null = document.getElementById('burger-btn');
    const isOpenClass: string = 'is-open';
    const isScrolledClass: string = 'is-scrolled';

    let isBurgerOpen: boolean = false;

    if (headerHtml && navigationHtml && burgerButton) {
        const openBurgerListener = () => {
            isBurgerOpen = !isBurgerOpen;

            if (isBurgerOpen) {
                navigationHtml.classList.add(isOpenClass);
                burgerButton.classList.add(isOpenClass);

                return;
            }

            navigationHtml.classList.remove(isOpenClass);
            burgerButton.classList.remove(isOpenClass);
        };

        burgerButton.addEventListener('click', openBurgerListener);

        document.addEventListener('scroll', () => {
           const lastScrollYPosition: number = window.scrollY;
           const headerThreshold: number = 40;

           if (lastScrollYPosition > headerThreshold) {
               headerHtml.classList.add(isScrolledClass);

               return;
           }

           headerHtml.classList.remove(isScrolledClass);
        });
    }
</script>