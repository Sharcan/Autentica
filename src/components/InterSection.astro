---
import firstRdv from "../assets/data/first-rdv.json";
---

<section class="inter-section">
    <div class="wrapper flex row align-center justify-between">
        <p class="font-display description">
            { firstRdv.description }
        </p>

        <div>
            <button class="book-btn uppercase">
                Réserver mon échange
            </button>
        </div>
    </div>
</section>

<style>
    .inter-section {
        background-color: var(--c-terracotta-deep);
        padding-block: var(--space-xl);
    }

    .wrapper {
        padding-inline: var(--space-xl);
        width: 100%;
        max-width: 1160px;
        margin-inline: auto;

        flex-wrap: wrap;
        gap: var(--space-m);
    }

    .description {
        color: var(--c-cream);
        font-size: var(--step-2);
        max-width: 30ch;
    }

    .book-btn {
        background-color: var(--c-cream);
        padding: var(--space-xs) var(--space-m);
        border-radius: var(--radius-pill);
        font-size: var(--step--1);
        font-weight: 500;
        letter-spacing: 0.1rem;

        transition: 300ms var(--ease);
    }

    .book-btn:hover {
        background-color: var(--c-sand);
        transform: translateY(-2px);
    }
</style>