---
import {buttonClassName} from "../../helpers/scroll-to-contact-section.helper.ts";

interface Props {
    label: string;
    type?: "submit" | "reset" | "button";
    class?: string;
}

const { label, type, class: className } = Astro.props;
---
<button class:list={['btn uppercase', buttonClassName]} type={type}>
    {label}
</button>

<style>
    .btn {
        background-color: var(--c-terracotta);

        color: var(--c-cream);
        padding: var(--space-xs) var(--space-m);
        border-radius: var(--radius-pill);
        font-size: var(--step--1);
        font-weight: 500;
        letter-spacing: 0.1rem;

        transition: 300ms var(--ease);
    }

    .btn:hover{
        color: var(--c-cream);
        transform: translateY(-2px);
    }
</style>
