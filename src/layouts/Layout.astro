---
import Font from "astro/components/Font.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#fcf0e4">
		<link rel="icon" type="image/svg+xml" href="/Autentica/favicon.svg" />
		<link rel="icon" href="/Autentica/favicon.ico" />
		<Font cssVariable="--font-display" />
		<Font cssVariable="--font-body" />
		<meta name="generator" content={Astro.generator} />
		<title>Autentica</title>
	</head>
	<body style="height: 300vh">
		<a class="skip-link" href="#contenu">Aller au contenu</a>

		<slot />
	</body>
</html>
