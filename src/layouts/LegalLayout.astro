---
import Divider from "../components/Divider.astro";
interface Props {
    title: string;
}

const { title } = Astro.props;

import OliveBranch from "../components/OliveBranch.astro";
---

<section class="flex column align-center g-m">
    <h1 class="font-display title">{title}</h1>


    <div class="olive-wrapper">
        <OliveBranch />
    </div>

    <Divider />

    <slot />
</section>

<style>
    .title {
        font-size: var(--step-4);
    }

    .olive-wrapper {
        width: 100px;
        color: var(--c-terracotta);
    }
</style>