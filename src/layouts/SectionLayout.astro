---
const { paddingInline = true, topSection = false, bottomSection = false, id, class: className } = Astro.props;
---

<section
     class:list={['wrapper', {'padding-inline': paddingInline, 'top-section': topSection, 'bottom-section': bottomSection }, className]}
    id={id}
>
    <slot />
</section>


<style>
    .wrapper {
        scroll-margin-top: var(--header-h);
    }

    .padding-inline {
        padding-inline: var(--space-2xl);
    }

    .top-section {
        padding-top: var(--space-2xl);
    }

    .bottom-section {
        padding-bottom: var(--space-2xl);
    }
</style>